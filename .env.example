# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Retrieve these from your Supabase Dashboard: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Supabase Service Role Key (Server-side ONLY, never expose to client!)
# Retrieve from: Settings -> API -> Project API keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# ==============================================================================
# Regional & Restaurant Defaults
# ==============================================================================
NEXT_PUBLIC_DEFAULT_CURRENCY=LKR
NEXT_PUBLIC_CURRENCY_SYMBOL=Rs.
NEXT_PUBLIC_TIMEZONE=Asia/Colombo
NEXT_PUBLIC_DEFAULT_BRANCH_ID=00000000-0000-0000-0000-000000000001
